{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "API_PORT",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "API_KEY_PEPPER",
    "APPLE_APP_IDS",
    "ACCESS_TOKEN_EXPIRY_MS",
    "REFRESH_TOKEN_EXPIRY_MS",
    "DATABASE_URL",
    "SHADOW_DATABASE_URL",
    "FRONTEND_URL",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "EMAIL_FROM",
    "LOG_LEVEL",
    "CI",
    "PLAYWRIGHT_BASE_URL",
    "PLAYWRIGHT_PROD_SERVER",
    "MAILPIT_URL",
    "TEST_USER_EMAIL",
    "TEST_USER_PASSWORD",
    "TEST_USER_NAME",
    "API_URL",
    "NEXT_PUBLIC_SITE_URL",
    "COOKIE_DOMAIN",
    "SMTP_REJECT_UNAUTHORIZED",
    "EMAIL_VERIFICATION_EXPIRY_MS",
    "PASSWORD_RESET_EXPIRY_MS",
    "ACCOUNT_DELETION_EXPIRY_MS",
    "NEXT_RUNTIME",
    "GIT_SHA",
    "MCP_SERVER_PORT",
    "API_BASE_URL",
    "MCP_PUBLIC_URL",
    "MCP_ALLOWED_HOSTS"
  ],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/dist/**"],
      "dependsOn": ["^build"]
    },
    "@luki-fitti/database#build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "src/generated/**"],
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "@luki-fitti/database#db:generate": {
      "cache": false,
      "dependsOn": ["^build", "build"]
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    },
    "db:push": {},
    "db:seed": {},
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "dependsOn": ["^generate"]
    }
  }
}

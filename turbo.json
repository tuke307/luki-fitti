{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ACCESS_TOKEN_EXPIRY_MS",
    "API_PORT",
    "API_URL",
    "CI",
    "DATABASE_URL",
    "EMAIL_FROM",
    "FRONTEND_URL",
    "JWT_SECRET",
    "LOG_LEVEL",
    "MAILPIT_URL",
    "NEXT_PUBLIC_LANDING_URL",
    "NEXT_PUBLIC_SITE_URL",
    "NODE_ENV",
    "PLAYWRIGHT_BASE_URL",
    "SMTP_HOST",
    "SMTP_PASS",
    "SMTP_PORT",
    "SMTP_USER",
    "TEST_USER_EMAIL",
    "TEST_USER_NAME",
    "TEST_USER_PASSWORD"
  ],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "public/dist/**"],
      "dependsOn": ["^build"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false
    },
    "db:push": {},
    "db:seed": {},
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "dependsOn": ["^generate"]
    }
  }
}

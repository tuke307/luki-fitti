{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "assets": [
      {
        "include": "../templates/**/*",
        "outDir": "dist/templates",
        "watchAssets": true
      },
      {
        "include": "modules/ai/prompts/*.md",
        "outDir": "dist/src",
        "watchAssets": true
      }
    ]
  }
}

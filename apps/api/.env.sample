# General
API_PORT=3001
NODE_ENV=development

# Auth
BCRYPT_SALT_ROUNDS=10
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY_MS=900000
REFRESH_TOKEN_EXPIRY_MS=7776000000
REFRESH_TOKEN_REUSE_GRACE_MS=30000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/luki_fitti

# Frontend
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=

# Redis
REDIS_URL=redis://localhost:6382

# SMTP / Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=false
EMAIL_FROM=apps@tony-luke.de
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=5000

# Web analytics (self-hosted Umami, pageviews only; forwarding only when NODE_ENV=production)
UMAMI_URL=https://umami.tony-luke.de
UMAMI_WEBSITE_ID=
# Comma-separated hostnames whose pageviews are forwarded
UMAMI_ALLOWED_HOSTNAMES=luki-fitti.tony-luke.de

# AI (OpenRouter). There is no global key: users add their own OpenRouter key (or an admin
# assigns one). Keys are stored AES-256-GCM encrypted with this 32-byte master key.
# Generate with: openssl rand -base64 32   — keep it in your secret store, never commit it.
# Without it, keys can't be stored, AI features stay off, and photo/avatar uploads are refused
# (stored objects are encrypted with a subkey derived from this key before upload). Losing it
# makes stored keys and stored objects unusable.
AI_KEY_ENCRYPTION_KEY=
# Rotation: move the old key here, put a new one above and bump the version; stored keys are
# re-encrypted lazily on their next use.
AI_KEY_ENCRYPTION_KEY_PREVIOUS=
AI_KEY_ENCRYPTION_KEY_VERSION=1
# Optional overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000

# SeaweedFS meal photo storage. Without it, photos are analysed but not kept.
# Host only (e.g. s3.tony-luke.de). Port defaults to 443 with TLS, 8333 without.
SEAWEEDFS_ENDPOINT=localhost
SEAWEEDFS_PORT=8335
SEAWEEDFS_ACCESS_KEY_API=
SEAWEEDFS_SECRET_KEY_API=
# TLS is on by default; set to 'false' only for a local HTTP SeaweedFS.
SEAWEEDFS_USE_SSL=false
SEAWEEDFS_BUCKET=luki-fitti-meal-photos

# Personal API keys (lf_pat_…): HMAC pepper for the key hashes.
# Production: at least 32 random characters (openssl rand -base64 48), otherwise API keys fail at
# first use. Locally a dev-only fallback is used when empty.
API_KEY_PEPPER=

# Web push (VAPID). Push stays off when empty. Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:apps@tony-luke.de

# iOS push (APNs). Push stays off when empty.
# APNS_KEY_P8_BASE64 is the .p8 key from Apple, base64-encoded: openssl base64 -A -in AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_P8_BASE64=

# Token lifetimes in ms (optional, defaults shown)
EMAIL_VERIFICATION_EXPIRY_MS=86400000
PASSWORD_RESET_EXPIRY_MS=3600000
ACCOUNT_DELETION_EXPIRY_MS=3600000

# Server URL written into the OpenAPI spec (only for yarn openapi:export)
PUBLIC_API_SERVER_URL=https://app.luki-fitti.tony-luke.de/api

# General
API_PORT=3001
NODE_ENV=development

# Auth
BCRYPT_SALT_ROUNDS=10
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY_MS=900000
REFRESH_TOKEN_EXPIRY_MS=604800000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5436/luki_fitti

# Frontend
FRONTEND_URL=http://localhost:3000
COOKIE_DOMAIN=

# Redis
REDIS_URL=redis://localhost:6382

# SMTP / Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_REJECT_UNAUTHORIZED=false
EMAIL_FROM=noreply@lukifitti.app
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_DELAY_MS=5000

# Web analytics (self-hosted Umami, pageviews only; forwarding only when NODE_ENV=production)
UMAMI_URL=https://umami.tony-luke.de
UMAMI_WEBSITE_ID=
# Comma-separated hostnames whose pageviews are forwarded
UMAMI_ALLOWED_HOSTNAMES=luki-fitti.tony-luke.de

# AI (OpenRouter). AI features stay off without a key. Never commit a real key.
OPENROUTER_API_KEY=
# Optional overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000

# Meal photo storage (S3-compatible, e.g. SeaweedFS). Without it, photos are analysed but not kept.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=luki-fitti-meal-photos
S3_FORCE_PATH_STYLE=true

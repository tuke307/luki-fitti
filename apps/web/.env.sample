# General
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth
JWT_SECRET=

# API base URL for server-side requests. Default: http://localhost:${API_PORT}/api
# API_URL=
# API_PORT=3001
# Browser calls the API directly instead of through the Next.js proxy (leave empty locally)
# NEXT_PUBLIC_DIRECT_API_URL=

# Origins and hostnames. Empty = localhost in dev, the luki-fitti.tony-luke.de domains in production
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_SITE_ORIGIN=http://site.localhost:3000
# NEXT_PUBLIC_DOCS_ORIGIN=http://docs.localhost:3000
# NEXT_PUBLIC_SITE_HOSTNAMES=site.localhost:3000
# NEXT_PUBLIC_DOCS_HOSTNAMES=docs.localhost:3000

# iOS app links (apple-app-site-association): comma-separated TEAMID.bundle.id
APPLE_APP_IDS=

# Docs site (optional). Roadmap page reads the GitHub project board; prepare-docs dates pages.
# Fine-grained token with read access to projects / repo contents.
GITHUB_PROJECT_TOKEN=
# GITHUB_PROJECT_OWNER=tuke307
# GITHUB_PROJECT_NUMBER=4
DOCS_GITHUB_TOKEN=

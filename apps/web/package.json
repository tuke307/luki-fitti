{
  "name": "@luki-fitti/web",
  "version": "2.2.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "author": "Tony Meissner",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "predev": "yarn prepare-docs",
    "prebuild": "yarn prepare-docs",
    "prepare-docs": "node scripts/prepare-docs.mjs && fumadocs-mdx ./source.config.ts ./.source",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "clean": "rm -rf .next",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test 'lib/**/*.spec.ts'",
    "test:e2e": "playwright test --grep-invert \"doc:\"",
    "test:e2e:chromium": "playwright test --project=chromium --grep-invert \"doc:\"",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "docs:screenshots": "playwright test doc-screenshots --project=chromium"
  },
  "dependencies": {
    "@fumadocs/mdx-remote": "1.5.3",
    "@hookform/resolvers": "^7.0.3",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@luki-fitti/common": "*",
    "@luki-fitti/logger": "*",
    "@luki-fitti/ui": "*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@scalar/api-client-react": "2.0.67",
    "@simplewebauthn/browser": "14.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-auto-scroll": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "framer-motion": "^14.10.1",
    "fumadocs-core": "16.19.3",
    "fumadocs-mdx": "15.6.3",
    "fumadocs-openapi": "12.6.5",
    "fumadocs-ui": "16.19.3",
    "jose": "^6.2.17",
    "js-cookie": "^3.0.8",
    "lucide-react": "^1.70.0",
    "mermaid": "12.3.0",
    "next": "^16.4.5",
    "next-intl": "^4.15.1",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-is": "^19.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@luki-fitti/database": "*",
    "@luki-fitti/eslint-config": "*",
    "@luki-fitti/typescript-config": "*",
    "@playwright/test": "^1.65.0",
    "@types/bcrypt": "^6.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "globals": "^17.14.0",
    "jsonwebtoken": "9.0.3",
    "jsqr": "1.4.0",
    "otplib": "13.6.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3"
  }
}

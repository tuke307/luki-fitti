{
  "name": "@luki-fitti/mcp-server",
  "version": "2.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Tony Meissner",
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias -f -fe .js",
    "clean": "rm -rf dist",
    "dev": "tsx watch --env-file=.env.local src/main.ts",
    "lint": "tsc --noEmit && eslint . --max-warnings 0",
    "start": "node --env-file=.env.local dist/main.js",
    "start:prod": "node dist/main.js",
    "test": "node --import tsx --test 'src/**/*.spec.ts'"
  },
  "dependencies": {
    "@luki-fitti/common": "*",
    "@luki-fitti/logger": "*",
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/microservices": "12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@rekog/mcp-nest": "2.0.8",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@luki-fitti/eslint-config": "*",
    "@luki-fitti/typescript-config": "*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "tsc-alias": "^1.9.7",
    "tsx": "^4.23.15",
    "typescript": "6.0.3"
  }
}

# MCP Server
MCP_SERVER_PORT=3030

# Main API: tool calls forward the caller's API key here
API_BASE_URL=http://localhost:3001/api

# Public MCP URL shown in docs and snippets (prod: https://app.luki-fitti.tony-luke.de/mcp)
MCP_PUBLIC_URL=http://localhost:3030/mcp

# Comma-separated Host/Origin allowlist (DNS-rebinding protection).
# "localhost" covers localhost, 127.0.0.1 and ::1.
MCP_ALLOWED_HOSTS=localhost

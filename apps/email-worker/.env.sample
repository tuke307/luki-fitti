# Email Worker
EMAIL_WORKER_PORT=3002

# Redis
REDIS_URL=redis://localhost:6382

# SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=apps@tony-luke.de

# Push (same values as apps/api: the worker sends pushes through the API's PushSenderService)
# Web push (VAPID). Push stays off when empty. Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:apps@tony-luke.de

# iOS push (APNs). Push stays off when empty.
# APNS_KEY_P8_BASE64 is the .p8 key from Apple, base64-encoded: openssl base64 -A -in AuthKey.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_KEY_P8_BASE64=

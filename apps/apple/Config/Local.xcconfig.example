// Copy to Local.xcconfig (gitignored) to sign with your own Apple ID / team.
// Team ID: Xcode > Settings > Accounts > select team, or developer.apple.com > Membership.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
CODE_SIGN_STYLE = Automatic

// Free Personal Teams need globally unique bundle IDs, e.g. com.yourname.lukifitti
LUKIFITTI_BUNDLE_ID_PREFIX = com.yourname.lukifitti

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  engineType      = "client"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

enum WeightUnit {
  KG
  LBS
}

enum DistanceUnit {
  KM
  MI
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  ABS_CORE
  HIP_FLEXORS
  FULL_BODY
}

enum ExerciseCategory {
  COMPOUND
  ISOLATION
  BODYWEIGHT
  MACHINE
  CABLE
  MOBILITY
  STRETCH
  CARDIO
}

enum ExerciseType {
  STRENGTH
  STRETCHING
  CARDIO
}

enum EquipmentType {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  EZ_BAR
  SMITH_MACHINE
  CARDIO_MACHINE
  FOAM_ROLLER
  NONE
  OTHER
}

enum SessionStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum SessionType {
  STRENGTH
  STRETCHING
  MIXED
}

enum SessionExerciseOrigin {
  PLANNED
  SUBSTITUTED
  ADDED
}

enum SessionExerciseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum SetType {
  WARMUP
  WORKING
  DROPSET
  STRETCH
}

enum SessionSourceDevice {
  WEB
  IPHONE
  APPLE_WATCH
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  name                     String?
  passwordHash             String
  emailVerified            Boolean   @default(true)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?
  accountDeletionToken     String?   @unique
  accountDeletionExpires   DateTime?
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  preferences        UserPreferences?
  refreshTokens      RefreshToken[]
  customExercises    Exercise[]
  workoutFolders     WorkoutFolder[]
  workoutTemplates   WorkoutTemplate[]
  workoutSessions    WorkoutSession[]
  stretchingRoutines StretchingRoutine[]
  importJobs         ImportJob[]
  emails             Email[]
}

model UserPreferences {
  id                         String       @id @default(uuid())
  userId                     String       @unique
  weightUnit                 WeightUnit   @default(KG)
  distanceUnit               DistanceUnit @default(KM)
  defaultRestSeconds         Int          @default(90)
  theme                      String       @default("system")
  language                   String       @default("system")
  restTimerSound             Boolean      @default(true)
  notificationsEnabled       Boolean      @default(true)
  exerciseSuggestionsEnabled Boolean      @default(true)
  weeklyGoalSessions         Int          @default(4)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Exercise {
  id                         String           @id @default(uuid())
  slug                       String           @unique
  userId                     String?
  name                       String
  description                String
  instructions               String[]         @default([])
  category                   ExerciseCategory @default(COMPOUND)
  exerciseType               ExerciseType     @default(STRENGTH)
  primaryMuscleGroup         MuscleGroup
  equipment                  EquipmentType    @default(BARBELL)
  recommendedDurationSeconds Int?
  tags                       String[]         @default([])
  isSystem                   Boolean          @default(false)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  user                       User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscleGroups               ExerciseMuscleGroup[]
  alternatives               ExerciseAlternative[]       @relation("ExerciseToAlternative")
  alternativeFor             ExerciseAlternative[]       @relation("AlternativeToExercise")
  media                      ExerciseMedia[]
  templateExercises          WorkoutTemplateExercise[]
  stretchingRoutineExercises StretchingRoutineExercise[]
  sessionExercises           SessionExercise[]

  @@index([userId])
  @@index([primaryMuscleGroup])
  @@index([exerciseType])
  @@index([equipment])
}

model ExerciseMuscleGroup {
  id          String      @id @default(uuid())
  exerciseId  String
  muscleGroup MuscleGroup
  isPrimary   Boolean     @default(false)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, muscleGroup])
  @@index([muscleGroup])
}

model ExerciseAlternative {
  id                    String  @id @default(uuid())
  exerciseId            String
  alternativeExerciseId String
  reason                String?

  exercise            Exercise @relation("ExerciseToAlternative", fields: [exerciseId], references: [id], onDelete: Cascade)
  alternativeExercise Exercise @relation("AlternativeToExercise", fields: [alternativeExerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, alternativeExerciseId])
  @@index([exerciseId])
}

model ExerciseMedia {
  id          String  @id @default(uuid())
  exerciseId  String
  mediaType   String  @default("SVG")
  url         String
  caption     String?
  attribution String?
  license     String?
  sortOrder   Int     @default(0)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

model WorkoutFolder {
  id        String   @id @default(uuid())
  userId    String
  /// Starter folder id from the catalog while untouched; text is then served from the catalog.
  systemKey String?
  name      String
  color     String   @default("#E8743B")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates WorkoutTemplate[]

  @@unique([userId, name])
  @@index([userId])
}

model WorkoutTemplate {
  id                       String   @id @default(uuid())
  userId                   String
  /// Starter template id from the catalog while untouched; text is then served from the catalog.
  systemKey                String?
  folderId                 String?
  name                     String
  description              String?
  estimatedDurationMinutes Int?     @default(60)
  sortOrder                Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    WorkoutFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  exercises WorkoutTemplateExercise[]
  sessions  WorkoutSession[]

  @@index([userId])
  @@index([folderId])
}

model WorkoutTemplateExercise {
  id                     String     @id @default(uuid())
  templateId             String
  exerciseId             String
  orderIndex             Int
  plannedSets            Int        @default(3)
  warmupSets             Int        @default(0)
  targetRepsMin          Int?       @default(8)
  targetRepsMax          Int?       @default(12)
  targetWeight           Float?
  weightUnit             WeightUnit @default(KG)
  restSeconds            Int        @default(90)
  targetDurationSeconds  Int?
  targetDistanceMeters   Float?
  notes                  String?
  alternativeExerciseIds String[]   @default([])

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([templateId, orderIndex])
  @@index([exerciseId])
}

model StretchingRoutine {
  id                       String   @id @default(uuid())
  userId                   String
  /// Starter routine id from the catalog while untouched; text is then served from the catalog.
  systemKey                String?
  name                     String
  description              String?
  targetArea               String   @default("Full Body")
  estimatedDurationSeconds Int      @default(600)
  isSystem                 Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises StretchingRoutineExercise[]
  sessions  WorkoutSession[]

  @@index([userId])
}

model StretchingRoutineExercise {
  id                String  @id @default(uuid())
  routineId         String
  exerciseId        String
  orderIndex        Int
  sets              Int     @default(1)
  durationSeconds   Int?    @default(45)
  reps              Int?
  transitionSeconds Int     @default(15)
  notes             String?

  routine  StretchingRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([routineId, orderIndex])
}

model WorkoutSession {
  id                    String              @id @default(uuid())
  clientSessionId       String              @unique
  userId                String
  templateId            String?
  stretchingRoutineId   String?
  sessionType           SessionType         @default(STRENGTH)
  workoutNameSnapshot   String
  status                SessionStatus       @default(IN_PROGRESS)
  startedAt             DateTime            @default(now())
  pausedAt              DateTime?
  completedAt           DateTime?
  activeDurationSeconds Int                 @default(0)
  weightUnit            WeightUnit          @default(KG)
  totalVolumeKg         Float               @default(0)
  totalSetsCompleted    Int                 @default(0)
  totalRepsCompleted    Int                 @default(0)
  totalStretchSeconds   Int                 @default(0)
  notes                 String?
  restTimerEndsAt       DateTime?
  restTimerDurationSec  Int?
  restTimerPausedRemSec Int?
  sourceDevice          SessionSourceDevice @default(WEB)
  healthKitWorkoutUuid  String?             @unique
  activeCaloriesKcal    Float?
  totalCaloriesKcal     Float?
  avgHeartRateBpm       Int?
  maxHeartRateBpm       Int?
  minHeartRateBpm       Int?
  heartRateSamplesJson  Json?
  version               Int                 @default(1)
  lastWriterDeviceId    String?
  lastSyncedAt          DateTime            @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template          WorkoutTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  stretchingRoutine StretchingRoutine? @relation(fields: [stretchingRoutineId], references: [id], onDelete: SetNull)
  exercises         SessionExercise[]

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([templateId])
}

model SessionExercise {
  id                     String                @id @default(uuid())
  clientExerciseId       String                @unique
  sessionId              String
  exerciseId             String?
  replacedExerciseId     String?
  replacedExerciseName   String?
  exerciseNameSnapshot   String
  primaryMuscleSnapshot  MuscleGroup
  exerciseTypeSnapshot   ExerciseType          @default(STRENGTH)
  origin                 SessionExerciseOrigin @default(PLANNED)
  status                 SessionExerciseStatus @default(PENDING)
  orderIndex             Int
  plannedSets            Int                   @default(3)
  plannedWarmupSets      Int                   @default(0)
  targetRepsMin          Int?
  targetRepsMax          Int?
  targetWeight           Float?
  targetDurationSeconds  Int?
  restSeconds            Int                   @default(90)
  alternativeExerciseIds String[]              @default([])
  notes                  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets     SessionSet[]

  @@index([sessionId, orderIndex])
  @@index([exerciseId])
}

model SessionSet {
  id                  String     @id @default(uuid())
  clientSetId         String     @unique
  sessionExerciseId   String
  setNumber           Int
  setType             SetType    @default(WORKING)
  weight              Float?
  weightUnit          WeightUnit @default(KG)
  reps                Int?
  durationSeconds     Int?
  distanceMeters      Float?
  rpe                 Float?
  completed           Boolean    @default(false)
  completedAt         DateTime?
  isPersonalRecord    Boolean    @default(false)
  notes               String?
  avgHeartRateBpm     Int?
  peakHeartRateBpm    Int?
  restEndHeartRateBpm Int?
  updatedAt           DateTime   @updatedAt

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId, setNumber])
}

model ImportJob {
  id                String   @id @default(uuid())
  userId            String
  sourceFormat      String
  fileName          String
  status            String   @default("COMPLETED")
  totalRecords      Int      @default(0)
  importedSessions  Int      @default(0)
  importedTemplates Int      @default(0)
  skippedDuplicates Int      @default(0)
  errorsCount       Int      @default(0)
  summaryJson       Json?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum EmailTemplateType {
  ACCOUNT_CONFIRMATION
  PASSWORD_RESET
  ACCOUNT_DELETION
}

enum EmailStatus {
  PROCESSING
  PENDING
  SENT
  FAILED
}

model EmailTemplate {
  id        Int               @id @default(autoincrement())
  name      String
  subject   String
  htmlFile  String            @unique
  type      EmailTemplateType @unique
  updatedAt DateTime          @updatedAt

  emails Email[]
}

model Email {
  id              Int         @id @default(autoincrement())
  recipientEmail  String
  subject         String
  content         String
  scheduledAt     DateTime    @default(now())
  sentAt          DateTime?
  status          EmailStatus @default(PENDING)
  attempts        Int         @default(0)
  lastAttemptAt   DateTime?
  errorMessage    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  emailTemplateId Int
  userId          String?

  emailTemplate EmailTemplate @relation(fields: [emailTemplateId], references: [id])
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emailTemplateId])
  @@index([userId])
  @@index([status, scheduledAt])
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  engineType      = "client"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

enum WeightUnit {
  KG
  LBS
}

enum DistanceUnit {
  KM
  MI
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  ABS_CORE
  HIP_FLEXORS
  FULL_BODY
}

enum ExerciseCategory {
  COMPOUND
  ISOLATION
  BODYWEIGHT
  MACHINE
  CABLE
  MOBILITY
  STRETCH
  CARDIO
}

enum ExerciseType {
  STRENGTH
  STRETCHING
  CARDIO
}

enum EquipmentType {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BAND
  EZ_BAR
  SMITH_MACHINE
  CARDIO_MACHINE
  FOAM_ROLLER
  NONE
  OTHER
}

enum MovementPattern {
  HORIZONTAL_PULL
  VERTICAL_PULL
  SHOULDER_EXTENSION
  HORIZONTAL_PUSH
  INCLINE_PUSH
  VERTICAL_PUSH
  DIP
  FLY
  LATERAL_RAISE
  FRONT_RAISE
  REAR_DELT
  UPRIGHT_ROW
  SHRUG
  SHOULDER_ROTATION
  ELBOW_FLEXION
  ELBOW_EXTENSION
  WRIST
  SQUAT
  HINGE
  LUNGE
  KNEE_EXTENSION
  KNEE_FLEXION
  HIP_THRUST
  HIP_EXTENSION
  HIP_ABDUCTION
  HIP_ADDUCTION
  HIP_FLEXION
  CALF_RAISE
  BACK_EXTENSION
  CORE_FLEXION
  ANTI_EXTENSION
  LATERAL_FLEXION
  ROTATION
  CARRY
  OLYMPIC_LIFT
}

enum Laterality {
  BILATERAL
  UNILATERAL
}

enum SessionStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum SessionType {
  STRENGTH
  STRETCHING
  MIXED
}

enum SessionExerciseOrigin {
  PLANNED
  SUBSTITUTED
  ADDED
}

enum SessionExerciseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum SetType {
  WARMUP
  WORKING
  DROPSET
  STRETCH
}

enum SessionSourceDevice {
  WEB
  IPHONE
  APPLE_WATCH
  IMPORT
}

enum TrainingGoal {
  STRENGTH
  HYPERTROPHY
  ENDURANCE
}

model User {
  id                       String    @id @default(uuid())
  email                    String    @unique
  name                     String?
  passwordHash             String
  emailVerified            Boolean   @default(true)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?   @unique
  passwordResetExpires     DateTime?
  accountDeletionToken     String?   @unique
  accountDeletionExpires   DateTime?
  failedLoginAttempts      Int       @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  /// Admin portal permissions (AdminPermission values). Empty = regular user.
  permissions              String[]  @default([])
  /// Social: unique @handle, stored lowercase; null = invisible to other users.
  handle                   String?   @unique
  handleChangedAt          DateTime?
  /// Storage key of the re-encoded 512px JPEG avatar (private, streamed by the API).
  avatarKey                String?
  avatarUpdatedAt          DateTime?
  /// SHA-256 hex of lower(trim(email)); powers opt-in contact matching.
  emailLookupHash          String?   @unique
  /// Opt-in "find me by email" contact matching.
  discoverableByEmail      Boolean   @default(true)
  /// Pause competing: hidden from leagues, no social pushes; friends stay.
  socialPaused             Boolean   @default(false)
  /// Current league arena; changed by the weekly rollover and inactivity drops.
  arena                    Arena     @default(BRONZE)
  /// Consecutive closed league weeks without a membership; at 2 the arena drops one step.
  leagueInactiveWeeks      Int       @default(0)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  preferences        UserPreferences?
  refreshTokens      RefreshToken[]
  customExercises    Exercise[]
  workoutFolders     WorkoutFolder[]
  workoutTemplates   WorkoutTemplate[]
  workoutSessions    WorkoutSession[]
  stretchingRoutines StretchingRoutine[]
  emails             Email[]
  mealEntries        MealEntry[]
  bodyWeightEntries  BodyWeightEntry[]
  healthDailyEnergy  HealthDailyEnergy[]
  healthWorkouts     HealthWorkout[]
  exerciseFeedback   ExerciseFeedback[]
  aiRuns             AiRun[]
  /// Encrypted OpenRouter keys (never select with the user; see UserAiKey).
  aiKeys             UserAiKey[]
  /// Personal API keys for the read-only public API (hashed secrets only).
  apiKeys            ApiKey[]
  importJobs         ImportJob[]
  progressCheckIns   ProgressCheckIn[]

  friendshipsA        Friendship[]          @relation("FriendshipUserA")
  friendshipsB        Friendship[]          @relation("FriendshipUserB")
  friendRequestsMade  Friendship[]          @relation("FriendshipRequestedBy")
  friendInvites       FriendInvite[]
  blocksMade          UserBlock[]           @relation("BlockBlocker")
  blocksReceived      UserBlock[]           @relation("BlockBlocked")
  reportsMade         UserReport[]          @relation("ReportReporter")
  reportsReceived     UserReport[]          @relation("ReportReported")
  reportsResolved     UserReport[]          @relation("ReportResolver")
  pushDevices         PushDevice[]
  notifications       Notification[]
  notificationActions Notification[]        @relation("NotificationActor")
  effortPointEntries  EffortPointEntry[]
  weeklyScores        WeeklyScore[]
  leagueMemberships   LeagueMembership[]
  duelsChallenged     Duel[]                @relation("DuelChallenger")
  duelsOpponent       Duel[]                @relation("DuelOpponent")
  duelsWon            Duel[]                @relation("DuelWinner")
  streaksRequested    FriendStreak[]        @relation("StreakRequestedBy")
  trophies            Trophy[]
  raidHits            RaidHit[]
  raidFinalBlows      Raid[]                @relation("RaidFinalBlow")
  raidSeen            RaidParticipantSeen[]
  squadMemberships    SquadMember[]
  squadsCreated       Squad[]               @relation("SquadCreator")
  squadInvites        SquadInvite[]         @relation("SquadInvited")
  squadInvitesSent    SquadInvite[]         @relation("SquadInviter")
}

model UserPreferences {
  id                         String        @id @default(uuid())
  userId                     String        @unique
  weightUnit                 WeightUnit    @default(KG)
  distanceUnit               DistanceUnit  @default(KM)
  defaultRestSeconds         Int           @default(90)
  theme                      String        @default("system")
  language                   String        @default("system")
  restTimerSound             Boolean       @default(true)
  notificationsEnabled       Boolean       @default(true)
  exerciseSuggestionsEnabled Boolean       @default(true)
  weeklyGoalSessions         Int           @default(4)
  bodyWeightKg               Float?
  heightCm                   Float?
  birthYear                  Int?
  /// "female" | "male" | null; only used for energy estimates.
  sex                        String?
  /// Body fat %; when set, energy and protein estimates use lean mass (Katch–McArdle).
  bodyFatPct                 Float?
  /// ActivityLevel value; everyday movement outside workouts, used without Apple Health.
  activityLevel              String?
  dailyKcalGoal              Int?
  proteinGoalG               Int?
  carbsGoalG                 Int?
  fatGoalG                   Int?
  weighInReminderEnabled     Boolean       @default(false)
  /// Calendar weekday (1 = Sunday … 7 = Saturday) for the weekly weigh-in reminder.
  weighInReminderWeekday     Int           @default(2)
  /// Minutes after local midnight for the weekly weigh-in reminder (450 = 07:30).
  weighInReminderMinutes     Int           @default(450)
  /// Body goal driving progress tracking (part of the goal section).
  bodyGoal                   BodyGoal?
  /// Training goal driving progression rep bands/rest; null = legacy behaviour.
  trainingGoal               TrainingGoal?
  /// 3, 6 or 12 — validated in the zod schema.
  goalHorizonMonths          Int?
  /// Opt-in cloud backup of progress photos (device-only by default).
  progressPhotoCloudBackup   Boolean       @default(false)
  /// Consent timestamp for AI target-image generation (part B).
  progressAiConsentAt        DateTime?
  /// Per-skill OpenRouter model choice: Partial<Record<AiSkillName, modelId>>; null = defaults.
  aiModels                   Json?
  /// Push category toggle: friend requests and accepted friendships.
  pushFriends                Boolean       @default(true)
  /// Push category toggle: league outcomes and end-of-week reminders.
  pushLeagues                Boolean       @default(true)
  /// Push category toggle: duel invites, standings and results.
  pushDuels                  Boolean       @default(true)
  /// Push category toggle: friend-streak invites, reminders and outcomes.
  pushStreaks                Boolean       @default(true)
  /// Push category toggle: raid spawns, phases, outcomes and squad activity.
  pushRaids                  Boolean       @default(true)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id          String    @id @default(uuid())
  token       String    @unique
  userId      String
  /// Device session (login) this token belongs to; rotation keeps the family.
  familyId    String
  deviceLabel String?
  rotatedAt   DateTime?
  lastUsedAt  DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Exercise {
  id                         String           @id @default(uuid())
  slug                       String           @unique
  userId                     String?
  name                       String
  description                String
  instructions               String[]         @default([])
  category                   ExerciseCategory @default(COMPOUND)
  exerciseType               ExerciseType     @default(STRENGTH)
  primaryMuscleGroup         MuscleGroup
  equipment                  EquipmentType    @default(BARBELL)
  recommendedDurationSeconds Int?
  tags                       String[]         @default([])
  isSystem                   Boolean          @default(false)
  /// Only stored for custom exercises; system exercises take it from the catalog.
  movementPattern            MovementPattern?
  laterality                 Laterality?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  user                       User?                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscleGroups               ExerciseMuscleGroup[]
  alternatives               ExerciseAlternative[]       @relation("ExerciseToAlternative")
  alternativeFor             ExerciseAlternative[]       @relation("AlternativeToExercise")
  media                      ExerciseMedia[]
  templateExercises          WorkoutTemplateExercise[]
  stretchingRoutineExercises StretchingRoutineExercise[]
  sessionExercises           SessionExercise[]
  feedback                   ExerciseFeedback[]

  @@index([userId])
  @@index([primaryMuscleGroup])
  @@index([exerciseType])
  @@index([equipment])
}

model ExerciseMuscleGroup {
  id          String      @id @default(uuid())
  exerciseId  String
  muscleGroup MuscleGroup
  isPrimary   Boolean     @default(false)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, muscleGroup])
  @@index([muscleGroup])
}

model ExerciseAlternative {
  id                    String  @id @default(uuid())
  exerciseId            String
  alternativeExerciseId String
  reason                String?

  exercise            Exercise @relation("ExerciseToAlternative", fields: [exerciseId], references: [id], onDelete: Cascade)
  alternativeExercise Exercise @relation("AlternativeToExercise", fields: [alternativeExerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, alternativeExerciseId])
  @@index([exerciseId])
}

model ExerciseMedia {
  id          String  @id @default(uuid())
  exerciseId  String
  mediaType   String  @default("SVG")
  url         String
  caption     String?
  attribution String?
  license     String?
  sortOrder   Int     @default(0)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

model WorkoutFolder {
  id        String   @id @default(uuid())
  userId    String
  /// Starter folder id from the catalog while untouched; text is then served from the catalog.
  systemKey String?
  name      String
  color     String   @default("#E8743B")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templates WorkoutTemplate[]

  @@unique([userId, name])
  @@index([userId])
}

model WorkoutTemplate {
  id                       String        @id @default(uuid())
  userId                   String
  /// Starter template id from the catalog while untouched; text is then served from the catalog.
  systemKey                String?
  folderId                 String?
  name                     String
  description              String?
  estimatedDurationMinutes Int?          @default(60)
  sortOrder                Int           @default(0)
  /// Optional per-template goal override; null falls back to the profile goal.
  trainingGoal             TrainingGoal?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder    WorkoutFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  exercises WorkoutTemplateExercise[]
  sessions  WorkoutSession[]

  @@index([userId])
  @@index([folderId])
}

model WorkoutTemplateExercise {
  id                     String     @id @default(uuid())
  templateId             String
  exerciseId             String
  orderIndex             Int
  /// Per-set plan `[{ setType, weight, reps, durationSeconds }]`; summary columns are derived from it.
  sets                   Json?
  plannedSets            Int        @default(3)
  warmupSets             Int        @default(0)
  targetRepsMin          Int?       @default(8)
  targetRepsMax          Int?       @default(12)
  targetWeight           Float?
  weightUnit             WeightUnit @default(KG)
  restSeconds            Int        @default(90)
  targetDurationSeconds  Int?
  targetDistanceMeters   Float?
  notes                  String?
  alternativeExerciseIds String[]   @default([])

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([templateId, orderIndex])
  @@index([exerciseId])
}

model StretchingRoutine {
  id                       String   @id @default(uuid())
  userId                   String
  /// Starter routine id from the catalog while untouched; text is then served from the catalog.
  systemKey                String?
  name                     String
  description              String?
  targetArea               String   @default("Full Body")
  estimatedDurationSeconds Int      @default(600)
  isSystem                 Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user      User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises StretchingRoutineExercise[]
  sessions  WorkoutSession[]

  @@index([userId])
}

model StretchingRoutineExercise {
  id                String  @id @default(uuid())
  routineId         String
  exerciseId        String
  orderIndex        Int
  sets              Int     @default(1)
  durationSeconds   Int?    @default(45)
  reps              Int?
  transitionSeconds Int     @default(15)
  notes             String?

  routine  StretchingRoutine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([routineId, orderIndex])
}

model WorkoutSession {
  id                    String              @id @default(uuid())
  clientSessionId       String              @unique
  userId                String
  templateId            String?
  stretchingRoutineId   String?
  sessionType           SessionType         @default(STRENGTH)
  /// Goal resolved at session creation (template ?? profile); null = legacy progression.
  trainingGoalSnapshot  TrainingGoal?
  workoutNameSnapshot   String
  status                SessionStatus       @default(IN_PROGRESS)
  startedAt             DateTime            @default(now())
  pausedAt              DateTime?
  completedAt           DateTime?
  activeDurationSeconds Int                 @default(0)
  weightUnit            WeightUnit          @default(KG)
  totalVolumeKg         Float               @default(0)
  totalSetsCompleted    Int                 @default(0)
  totalRepsCompleted    Int                 @default(0)
  totalStretchSeconds   Int                 @default(0)
  notes                 String?
  restTimerEndsAt       DateTime?
  restTimerDurationSec  Int?
  restTimerPausedRemSec Int?
  sourceDevice          SessionSourceDevice @default(WEB)
  healthKitWorkoutUuid  String?             @unique
  activeCaloriesKcal    Float?
  totalCaloriesKcal     Float?
  /// Server-side burn estimate (HealthKit value when present, otherwise MET-based).
  estimatedCaloriesKcal Float?
  avgHeartRateBpm       Int?
  maxHeartRateBpm       Int?
  minHeartRateBpm       Int?
  heartRateSamplesJson  Json?
  version               Int                 @default(1)
  lastWriterDeviceId    String?
  lastSyncedAt          DateTime            @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template          WorkoutTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  stretchingRoutine StretchingRoutine? @relation(fields: [stretchingRoutineId], references: [id], onDelete: SetNull)
  exercises         SessionExercise[]
  effortPointEntry  EffortPointEntry?

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([templateId])
}

model SessionExercise {
  id                     String                @id @default(uuid())
  clientExerciseId       String                @unique
  sessionId              String
  exerciseId             String?
  replacedExerciseId     String?
  replacedExerciseName   String?
  exerciseNameSnapshot   String
  primaryMuscleSnapshot  MuscleGroup
  exerciseTypeSnapshot   ExerciseType          @default(STRENGTH)
  origin                 SessionExerciseOrigin @default(PLANNED)
  status                 SessionExerciseStatus @default(PENDING)
  orderIndex             Int
  plannedSets            Int                   @default(3)
  plannedWarmupSets      Int                   @default(0)
  targetRepsMin          Int?
  targetRepsMax          Int?
  targetWeight           Float?
  targetDurationSeconds  Int?
  restSeconds            Int                   @default(90)
  alternativeExerciseIds String[]              @default([])
  notes                  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  sets     SessionSet[]

  @@index([sessionId, orderIndex])
  @@index([exerciseId])
}

model SessionSet {
  id                  String     @id @default(uuid())
  clientSetId         String     @unique
  sessionExerciseId   String
  setNumber           Int
  setType             SetType    @default(WORKING)
  weight              Float?
  weightUnit          WeightUnit @default(KG)
  reps                Int?
  durationSeconds     Int?
  distanceMeters      Float?
  rpe                 Float?
  completed           Boolean    @default(false)
  completedAt         DateTime?
  isPersonalRecord    Boolean    @default(false)
  notes               String?
  avgHeartRateBpm     Int?
  peakHeartRateBpm    Int?
  restEndHeartRateBpm Int?
  updatedAt           DateTime   @updatedAt

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)

  @@index([sessionExerciseId, setNumber])
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin & AI
// ─────────────────────────────────────────────────────────────────────────────

/// Single-row application settings (id = 1), edited in the admin portal.
model AppSettings {
  id                      Int             @id @default(1)
  /// Global kill switches. A user additionally needs a usable OpenRouter key.
  aiWorkoutBuilderEnabled Boolean         @default(true)
  aiMealPhotoEnabled      Boolean         @default(true)
  /// OpenRouter model ids (e.g. "openai/gpt-6.1-terra"); fallbacks are tried in order.
  workoutBuilderModel     String          @default("openai/gpt-6.1-terra")
  workoutBuilderFallbacks String[]        @default(["google/gemini-3.8-flash"])
  mealPhotoModel          String          @default("google/gemini-3.8-flash")
  mealPhotoFallbacks      String[]        @default(["openai/gpt-6.1-terra"])
  /// Max AI runs per user per UTC day across all AI features.
  aiDailyRunLimit         Int             @default(30)
  /// Delete stored meal photos after N days; null keeps them until the meal is deleted.
  mealPhotoRetentionDays  Int?
  /// Models users on an admin-assigned key may choose from (own-key users may pick any capable model).
  userModelAllowlist      String[]        @default([])
  /// AI "target photo" for progress tracking (part B).
  aiProgressTargetEnabled Boolean         @default(true)
  progressTargetModel     String          @default("google/gemini-nano-banana-2.1")
  progressTargetFallbacks String[]        @default(["bytedance-seed/seedream-5-0-flash"])
  /// Social kill switch: off by default, enabled per rollout (see docs/social-2.0.md).
  socialEnabled           Boolean         @default(false)
  /// Beta allowlist; empty = everyone once socialEnabled is on.
  socialBetaUserIds       String[]        @default([])
  /// Leagues/effort-points kill switch: off → /league/* 403 and no points recorded.
  leaguesEnabled          Boolean         @default(true)
  /// AUTO picks the stage from activeUsers thresholds; the other values force it.
  leagueStageMode         LeagueStageMode @default(AUTO)
  /// AUTO: minimum eligible users active last week for stage GLOBAL.
  leagueStage2MinUsers    Int             @default(10)
  /// AUTO: minimum eligible users active last week for stage ARENAS.
  leagueStage3MinUsers    Int             @default(150)
  /// Maximum members per cohort (GLOBAL ignores this: one cohort per week).
  leagueCohortSize        Int             @default(30)
  /// Per-day cap applied when the weekly score is recomputed.
  epDailyCap              Int             @default(600)
  /// Weekly bonus when entries with points > 0 reach the user's weeklyGoalSessions.
  epWeeklyGoalBonus       Int             @default(100)
  /// Duels kill switch: off → /duels/* 403 and the tick/standings jobs no-op.
  duelsEnabled            Boolean         @default(true)
  /// Friend-streak kill switch: off → /streaks/* 403 and no evaluation/reminders.
  streaksEnabled          Boolean         @default(true)
  /// Raids kill switch: off → /raids/* and /squads/* 403, no spawn/escape/damage.
  raidsEnabled            Boolean         @default(true)
  /// Community raid HP per eligible active user (last 4 closed weeks).
  raidHpPerActiveUser     Int             @default(400)
  /// Community raid HP floor.
  raidMinHp               Int             @default(2000)
  /// Personal API keys kill switch: off → /api/v1/* 403 and key creation blocked.
  apiKeysEnabled          Boolean         @default(false)
  /// MCP server kill switch: off → /api/v1/key 403, so AI assistants can't connect.
  mcpEnabled              Boolean         @default(false)
  updatedAt               DateTime        @updatedAt
}

/// Who provided the OpenRouter key used for AI runs.
enum AiKeySlot {
  /// Set by the user themselves (bring-your-own-key; no grant or daily limit needed).
  USER
  /// Assigned to the user by an admin (feature grants + daily limit still apply).
  ADMIN
}

/// Per-user OpenRouter API key, AES-256-GCM encrypted with AI_KEY_ENCRYPTION_KEY.
/// AAD binds each ciphertext to `${userId}:${slot}`. The plaintext is never returned to clients.
model UserAiKey {
  id          String    @id @default(uuid())
  userId      String
  slot        AiKeySlot
  ciphertext  String
  iv          String
  authTag     String
  /// Master key version used for encryption (rotation support).
  keyVersion  Int       @default(1)
  /// Last 4 characters of the key, shown as a hint ("…abcd").
  last4       String
  /// Admin who set an ADMIN-slot key (null for USER keys).
  setByUserId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
}

/// Personal API key (`lf_pat_<id>_<secret>`) for the read-only public API /api/v1.
/// Only the HMAC-SHA256(API_KEY_PEPPER, secret) hash is stored; the secret is shown once.
model ApiKey {
  /// The 8-char public id embedded in the key (lookup key, shown in the UI).
  id         String    @id
  userId     String
  /// 1–40 chars.
  name       String
  /// hex(HMAC-SHA256(API_KEY_PEPPER, secret)).
  secretHash String
  /// ApiKeyScope values, validated in zod.
  scopes     String[]
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  /// Updated at most once per minute per key (Redis-gated, fire-and-forget).
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AiRunStatus {
  SUCCESS
  ERROR
}

/// One AI harness run (usage + cost accounting). Never stores prompt or photo content.
model AiRun {
  id               String      @id @default(uuid())
  userId           String?
  skill            String
  model            String?
  status           AiRunStatus
  steps            Int         @default(0)
  promptTokens     Int         @default(0)
  completionTokens Int         @default(0)
  costUsd          Float?
  durationMs       Int         @default(0)
  errorCode        String?
  /// Which key slot paid for the run (null for runs before per-user keys).
  keySource        AiKeySlot?
  createdAt        DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([skill, createdAt])
  @@index([createdAt])
}

enum ExerciseFeedbackVerdict {
  NOT_WORKING
  PAIN
  DISLIKE
}

/// Explicit "this exercise doesn't work for me" mark, used by the AI workout builder.
model ExerciseFeedback {
  id         String                  @id @default(uuid())
  userId     String
  exerciseId String
  verdict    ExerciseFeedbackVerdict
  note       String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Nutrition
// ─────────────────────────────────────────────────────────────────────────────

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  COFFEE
  DRINK
  OTHER
}

enum FoodItemSource {
  MANUAL
  AI
}

enum MealAmountUnit {
  G
  ML
}

model MealEntry {
  id            String   @id @default(uuid())
  /// Client-generated id so offline-created entries sync idempotently.
  clientEntryId String   @unique
  userId        String
  eatenAt       DateTime
  mealType      MealType @default(OTHER)
  /// Free-form name ("Post-workout shake"), shown instead of the meal type when set.
  label         String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  MealItem[]
  photos MealPhoto[]

  @@index([userId, eatenAt])
}

model MealItem {
  id          String         @id @default(uuid())
  mealEntryId String
  orderIndex  Int            @default(0)
  name        String
  /// Amount in `amountUnit` (grams for solids, millilitres for drinks).
  grams       Float?
  amountUnit  MealAmountUnit @default(G)
  kcal        Float          @default(0)
  proteinG    Float          @default(0)
  carbsG      Float          @default(0)
  fatG        Float          @default(0)
  fiberG      Float?
  sugarG      Float?
  source      FoodItemSource @default(MANUAL)
  /// 0..1 model confidence for AI-estimated items.
  confidence  Float?

  mealEntry MealEntry @relation(fields: [mealEntryId], references: [id], onDelete: Cascade)

  @@index([mealEntryId, orderIndex])
}

model MealPhoto {
  id          String   @id @default(uuid())
  mealEntryId String
  storageKey  String   @unique
  mimeType    String
  sizeBytes   Int
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  mealEntry MealEntry @relation(fields: [mealEntryId], references: [id], onDelete: Cascade)

  @@index([mealEntryId])
  @@index([createdAt])
}

enum EmailTemplateType {
  ACCOUNT_CONFIRMATION
  PASSWORD_RESET
  ACCOUNT_DELETION
  API_KEY_CREATED
}

enum EmailStatus {
  PROCESSING
  PENDING
  SENT
  FAILED
}

model EmailTemplate {
  id        Int               @id @default(autoincrement())
  name      String
  subject   String
  htmlFile  String            @unique
  type      EmailTemplateType @unique
  updatedAt DateTime          @updatedAt

  emails Email[]
}

model Email {
  id              Int         @id @default(autoincrement())
  recipientEmail  String
  subject         String
  content         String
  scheduledAt     DateTime    @default(now())
  sentAt          DateTime?
  status          EmailStatus @default(PENDING)
  attempts        Int         @default(0)
  lastAttemptAt   DateTime?
  errorMessage    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  emailTemplateId Int
  userId          String?

  emailTemplate EmailTemplate @relation(fields: [emailTemplateId], references: [id])
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([emailTemplateId])
  @@index([userId])
  @@index([status, scheduledAt])
}

enum BodyGoal {
  BUILD_MUSCLE
  LOSE_FAT
  RECOMP
  MAINTAIN
}

enum ProgressPose {
  FRONT
  SIDE
  BACK
}

enum ProgressPhotoKind {
  PHOTO
  AI_TARGET
}

/// A dated progress check-in: up to three pose photos, an optional note and an optional
/// weigh-in. Photos live on the device by default; cloud backup is the user's opt-in.
model ProgressCheckIn {
  id                      String   @id @default(uuid())
  /// Client-generated id so offline-created check-ins sync idempotently.
  clientEntryId           String   @unique
  userId                  String
  takenAt                 DateTime
  note                    String?
  /// The BodyWeightEntry created for this check-in's weight; the weight itself isn't stored here.
  bodyWeightClientEntryId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos ProgressPhoto[]

  @@index([userId, takenAt])
}

model ProgressPhoto {
  id              String            @id @default(uuid())
  /// Client-generated id so re-uploads replace, never duplicate.
  clientPhotoId   String            @unique
  checkInId       String
  pose            ProgressPose
  kind            ProgressPhotoKind @default(PHOTO)
  /// Server-generated storage path `progress/<userId>/<checkInId>/<uuid>.jpg`.
  storageKey      String            @unique
  mimeType        String
  sizeBytes       Int
  width           Int?
  height          Int?
  /// AI generation metadata for kind = AI_TARGET (part B).
  aiModel         String?
  aiGoal          BodyGoal?
  aiHorizonMonths Int?
  createdAt       DateTime          @default(now())

  checkIn ProgressCheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([checkInId])
}

enum BodyWeightSource {
  MANUAL
  HEALTHKIT
}

model BodyWeightEntry {
  id            String           @id @default(uuid())
  /// Client-generated id so offline-created entries sync idempotently.
  clientEntryId String           @unique
  userId        String
  measuredAt    DateTime
  weightKg      Float
  source        BodyWeightSource @default(MANUAL)
  /// HealthKit sample UUID for imported entries (dedupe on re-import).
  healthKitUuid String?
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, healthKitUuid])
  @@index([userId, measuredAt])
}

/// Apple Health active energy per device-local calendar day (imported from the iOS app).
model HealthDailyEnergy {
  id         String   @id @default(uuid())
  userId     String
  /// Device-local calendar day, "YYYY-MM-DD".
  day        String
  activeKcal Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

/// Apple Health workout (own LukiFitti sessions written to Health, or from other apps/devices).
model HealthWorkout {
  id             String   @id @default(uuid())
  userId         String
  /// HealthKit workout UUID (lowercase); dedupe key on re-import.
  healthKitUuid  String
  /// camelCase HKWorkoutActivityType name, e.g. "running", "traditionalStrengthTraining".
  activityType   String
  sourceName     String
  /// True when the workout was written to Health by LukiFitti itself.
  isOwn          Boolean  @default(false)
  startedAt      DateTime
  endedAt        DateTime
  activeKcal     Float?
  distanceMeters Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, healthKitUuid])
  @@index([userId, startedAt])
}

enum ImportJobStatus {
  SUCCESS
  FAILED
}

/// One row per file import commit attempt. Never stores the file or any set data, only counts.
model ImportJob {
  id        String          @id @default(uuid())
  userId    String
  /// File format, e.g. "luki-fitti-import@1".
  format    String
  sourceApp String
  status    ImportJobStatus
  /// Per-kind counts `{ customExercises, folders, templates, sessions: { total, new, existing }, ... }`.
  counts    Json
  errorCode String?
  createdAt DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum PushPlatform {
  APNS
  WEBPUSH
}

enum ReportReason {
  SPAM
  HARASSMENT
  INAPPROPRIATE_NAME
  INAPPROPRIATE_AVATAR
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationKind {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  LEAGUE_PROMOTED
  LEAGUE_DEMOTED
  LEAGUE_ENDING
  DUEL_INVITE
  DUEL_ACCEPTED
  DUEL_STANDINGS
  DUEL_RESULT
  STREAK_INVITE
  STREAK_STARTED
  STREAK_REMINDER
  STREAK_FROZEN
  STREAK_BROKEN
  RAID_SPAWNED
  RAID_PHASE
  RAID_DEFEATED
  RAID_ESCAPED
  SQUAD_INVITE
  SQUAD_RAID_STARTED
}

/// Mutual friendship. The pair is stored once with userAId < userBId;
/// PENDING until the other side accepts (requestedById records who asked).
model Friendship {
  id            String           @id @default(uuid())
  userAId       String
  userBId       String
  requestedById String
  status        FriendshipStatus
  createdAt     DateTime         @default(now())
  acceptedAt    DateTime?

  userA       User          @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User          @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)
  requestedBy User          @relation("FriendshipRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  /// One streak per friendship; cascades with it (unfriend/block end the streak).
  streak      FriendStreak?

  @@unique([userAId, userBId])
  @@index([userBId])
}

/// Shareable friend-invite link. Only the SHA-256 of the token is stored —
/// a DB leak can never mint invite links.
model FriendInvite {
  id          String   @id @default(uuid())
  /// SHA-256 hex of the random base64url token in the URL.
  tokenHash   String   @unique
  createdById String
  expiresAt   DateTime
  maxUses     Int      @default(20)
  uses        Int      @default(0)
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
}

/// Block hides both users from each other everywhere (deny by default).
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// UGC moderation report; snapshots keep evidence even if the profile changes later.
model UserReport {
  id                String       @id @default(uuid())
  reporterId        String
  reportedId        String
  reason            ReportReason
  /// Free-text context, max 500 chars (validated in zod).
  details           String?
  handleSnapshot    String?
  nameSnapshot      String?
  avatarKeySnapshot String?
  status            ReportStatus @default(OPEN)
  createdAt         DateTime     @default(now())
  resolvedAt        DateTime?
  resolvedById      String?

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User  @relation("ReportReported", fields: [reportedId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// One push target per device: APNs device token or Web Push subscription endpoint.
model PushDevice {
  id          String       @id @default(uuid())
  userId      String
  platform    PushPlatform
  /// APNs hex token or Web Push endpoint URL; unique so a reinstall moves it to its owner.
  token       String       @unique
  /// Web Push keys (null for APNs).
  p256dh      String?
  auth        String?
  /// Debug builds use the APNs sandbox environment.
  apnsSandbox Boolean      @default(false)
  /// BCP-47 locale ("en", "de") for notification text.
  locale      String
  /// IANA time zone for quiet hours, e.g. "Europe/Berlin".
  timeZone    String
  lastSeenAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// In-app notification inbox; mirrors every push so it works without push permission.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind
  /// The user the notification is about (e.g. the friend who requested).
  actorId   String?
  /// Extra data for the client (deep-link url, etc.); never PII beyond the actor.
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Leagues (PR 2): effort points ledger, weekly scores, cohorts
// ─────────────────────────────────────────────────────────────────────────────

enum Arena {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  OBSIDIAN
  TITAN
}

enum LeagueStage {
  FRIENDS
  GLOBAL
  ARENAS
}

enum LeagueStageMode {
  AUTO
  FRIENDS
  GLOBAL
  ARENAS
}

enum LeagueOutcome {
  PROMOTED
  STAYED
  DEMOTED
}

/// One ledger entry per completed session: points can only go down on recompute.
model EffortPointEntry {
  id          String   @id @default(uuid())
  userId      String
  /// FK cascade: deleting the session deletes its points; WeeklyScore is recomputed.
  sessionId   String   @unique
  /// League week of the session (Monday of its Berlin completion day, YYYY-MM-DD).
  weekKey     String
  /// Berlin calendar day of the session, YYYY-MM-DD.
  dayKey      String
  /// Effective points: firstPoints on create, min(firstPoints, recompute) afterwards.
  points      Int
  /// Points at first computation — the ceiling for later edits.
  firstPoints Int
  /// computeSessionEffortPoints breakdown (audit + UI).
  breakdown   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, weekKey])
}

/// Weekly aggregate per user: daily-capped points + goal bonus, recomputed from the ledger.
model WeeklyScore {
  id          String   @id @default(uuid())
  userId      String
  weekKey     String
  /// Sum over days of min(epDailyCap, day points) + goalBonus.
  points      Int
  /// Uncapped weekly sum (no daily cap, no bonus).
  rawPoints   Int
  /// Number of ledger entries this week.
  sessions    Int
  /// epWeeklyGoalBonus when the weekly session goal was met, else 0.
  goalBonus   Int
  /// Entries with points > 0 reached the user's weeklyGoalSessions (streak input;
  /// independent of epWeeklyGoalBonus).
  goalReached Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  /// Leaderboard/cohort scans order by points within a week.
  @@index([weekKey, points])
}

/// One row per league week; created lazily on first access or by the rollover.
/// closedAt marks the rollover as done — the guard that makes it idempotent.
model LeagueWeek {
  weekKey     String      @id
  stage       LeagueStage
  /// Eligible users with WeeklyScore.points > 0 in the previous week (AUTO input).
  activeUsers Int
  /// ARENAS only: Arena → bucket index, computed at creation (see league.util).
  buckets     Json?
  closedAt    DateTime?
  createdAt   DateTime    @default(now())
}

/// A ranked group for one week. bucket = arena bucket (ARENAS); null = GLOBAL.
model LeagueCohort {
  id        String   @id @default(uuid())
  weekKey   String
  bucket    Int?
  createdAt DateTime @default(now())

  members LeagueMembership[]

  @@index([weekKey, bucket])
}

/// One row per user per week: the cohort they ranked in and the rollover result.
model LeagueMembership {
  id           String         @id @default(uuid())
  cohortId     String
  userId       String
  /// Denormalised for the (userId, weekKey) unique constraint and lookups.
  weekKey      String
  arenaAtStart Arena
  finalPoints  Int?
  finalRank    Int?
  outcome      LeagueOutcome?
  /// Set once the client has shown the promotion/demotion celebration.
  resultSeenAt DateTime?
  joinedAt     DateTime       @default(now())

  cohort LeagueCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([cohortId])
}

enum DuelStatus {
  PENDING
  ACTIVE
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED
}

enum FriendStreakStatus {
  PENDING
  ACTIVE
}

enum TrophyKind {
  DUEL_WIN
  RAID_DEFEATED
  RAID_CROWN
  RAID_FINAL_BLOW
}

/// 1v1 weekly duel between friends. Scores are the daily-capped EP sums over
/// [startDayKey, endDayKey); recomputed on each session sync and at completion.
model Duel {
  id                  String     @id @default(uuid())
  challengerId        String
  opponentId          String
  status              DuelStatus @default(PENDING)
  createdAt           DateTime   @default(now())
  respondedAt         DateTime?
  /// Berlin day the duel starts (set on accept); YYYY-MM-DD.
  startDayKey         String?
  /// Exclusive end day key: startDayKey + 7.
  endDayKey           String?
  /// Berlin-midnight UTC instants matching the day keys.
  startsAt            DateTime?
  endsAt              DateTime?
  challengerPoints    Int        @default(0)
  opponentPoints      Int        @default(0)
  winnerId            String?
  isTie               Boolean    @default(false)
  /// Set once each side has seen the result (drives pendingResult).
  challengerSeenAt    DateTime?
  opponentSeenAt      DateTime?
  /// Guard for the once-per-day standings push.
  lastStandingsDayKey String?

  challenger User  @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponent   User  @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  winner     User? @relation("DuelWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([challengerId, status])
  @@index([opponentId, status])
  /// The tick job scans ACTIVE duels by endsAt.
  @@index([status, endsAt])
}

/// Weekly friend streak: both partners hitting their weeklyGoalSessions keeps
/// the count alive; up to 2 freezes absorb a missed week. Cascades with the
/// friendship, so unfriending or blocking ends it silently.
model FriendStreak {
  id                   String             @id @default(uuid())
  friendshipId         String             @unique
  status               FriendStreakStatus
  requestedById        String
  count                Int                @default(0)
  longest              Int                @default(0)
  /// League week (Monday, YYYY-MM-DD) the streak started counting.
  startedWeekKey       String?
  /// Last closed week the rollover evaluated.
  lastEvaluatedWeekKey String?
  /// Banked freezes (max 2).
  freezes              Int                @default(0)
  /// Consecutive kept weeks since the last freeze was earned/consumed.
  weeksSinceFreeze     Int                @default(0)
  /// Guard for the once-per-week reminder.
  lastReminderWeekKey  String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  friendship  Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("StreakRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
}

/// Earned achievements; one row per (user, kind, refId). PR 4 adds RAID_* kinds.
model Trophy {
  id        String     @id @default(uuid())
  userId    String
  kind      TrophyKind
  /// Source object (e.g. the duel id) — keeps the award idempotent.
  refId     String
  tier      String?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId])
  @@index([userId, createdAt])
}

enum RaidKind {
  /// One shared boss for everyone, spawned every week.
  COMMUNITY
  /// A squad's own boss, one per squad per week.
  SQUAD
}

enum RaidStatus {
  ACTIVE
  DEFEATED
  ESCAPED
}

enum RaidDifficulty {
  NORMAL
  HARD
  HEROIC
}

enum SquadRole {
  OWNER
  MEMBER
}

/// Weekly raid boss. COMMUNITY rows have squadId = null (uniqueness is enforced
/// by the partial index "Raid_community_week" added in the raids migration).
/// `damage` is the running sum of all applied RaidHits.
model Raid {
  id              String          @id @default(uuid())
  kind            RaidKind
  squadId         String?
  bossSlug        String
  difficulty      RaidDifficulty?
  /// League week (Monday, YYYY-MM-DD) the raid belongs to.
  weekKey         String
  startsAt        DateTime
  endsAt          DateTime
  maxHp           Int
  damage          Int             @default(0)
  /// Enrage thresholds crossed: 1/2/3 at 75/50/25 % HP left.
  phase           Int             @default(0)
  status          RaidStatus      @default(ACTIVE)
  defeatedAt      DateTime?
  finalBlowUserId String?
  createdAt       DateTime        @default(now())

  squad     Squad?                @relation(fields: [squadId], references: [id], onDelete: Cascade)
  finalBlow User?                 @relation("RaidFinalBlow", fields: [finalBlowUserId], references: [id], onDelete: SetNull)
  hits      RaidHit[]
  seenBy    RaidParticipantSeen[]

  @@unique([kind, weekKey, squadId])
  /// The spawn/escape job scans ACTIVE raids by endsAt.
  @@index([status, endsAt])
  @@index([squadId, weekKey])
}

/// One hit = one completed session applied to one raid. `firstDamage` keeps the
/// first computed value so a re-sync can only lower the hit (min, like the
/// EffortPointEntry ledger).
model RaidHit {
  id             String   @id @default(uuid())
  raidId         String
  userId         String
  sessionId      String
  damage         Int
  firstDamage    Int
  /// The portion of `damage` earned through the boss's weak spots (2× part).
  weakSpotDamage Int      @default(0)
  /// Display label for the feed (friends/self only — privacy filtered on read).
  topExercise    String?
  /// Berlin day of the hit, for the per-user-per-day damage cap.
  dayKey         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  raid Raid @relation(fields: [raidId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raidId, sessionId])
  @@index([raidId, createdAt])
  @@index([raidId, userId])
}

/// Defeat/escape celebration is shown once per participant.
model RaidParticipantSeen {
  raidId String
  userId String
  seenAt DateTime @default(now())

  raid Raid @relation(fields: [raidId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([raidId, userId])
}

/// Friend raid squad: max 10 members, 3 squads per user, friends-only invites.
model Squad {
  id          String   @id @default(uuid())
  name        String
  createdById String
  createdAt   DateTime @default(now())

  createdBy User          @relation("SquadCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members   SquadMember[]
  invites   SquadInvite[]
  raids     Raid[]
}

model SquadMember {
  squadId  String
  userId   String
  role     SquadRole
  joinedAt DateTime  @default(now())

  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([squadId, userId])
  @@index([userId])
}

model SquadInvite {
  id          String   @id @default(uuid())
  squadId     String
  invitedId   String
  invitedById String
  createdAt   DateTime @default(now())

  squad     Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)
  invited   User  @relation("SquadInvited", fields: [invitedId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("SquadInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([squadId, invitedId])
}

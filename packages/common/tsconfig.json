{
  "extends": "@luki-fitti/typescript-config/library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "paths": {
      "@luki-fitti/common/*": ["./src/*"],
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "src/**/*.spec.ts"],
  "include": ["src", "src/**/*.json"]
}
